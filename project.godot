; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but can be edited manually as well.

config_version=5

[application]

config/name="Composite - Modern Tank Simulator"
config/description="Modern armored vehicle sandbox simulator built in Godot Engine 4.7"
run/main_scene="res://scenes/main_menu/main_menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

SettingsManager="*res://scripts/core/settings_manager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/mode=0
window/size/resizable=true

[physics]

3d/physics_engine="Jolt"
3d/default_gravity=9.81
3d/default_gravity_vector=Vector3(0, -1, 0)

[rendering]

renderer/rendering_method="forward_plus"
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_aa=1

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_mcp/plugin.cfg")
